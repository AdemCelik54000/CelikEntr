# Cloudinary credentials (required for `npm run media:upload` and for local Netlify Functions)
# Put the real values in a local `.env` (never commit it).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: prefix for relative URLs in the media manifest (e.g. CDN base URL)
VITE_MEDIA_BASE_URL=

# Base folder used by the Netlify function to list Cloudinary assets
VITE_CLOUDINARY_BASE_FOLDER=celik-portfolio

# Base site URL used for SEO tags in index.html
VITE_SITE_URL=https://celikbatiment.com
